# README embeds.
shots/

# verification artefacts from a local install/restart run
verify-report.txt
new-dsh-url.txt
profile-backup-*/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# scratch DSH home used by the e2e harness (isolated settings/sessions)
.scratch-home/
